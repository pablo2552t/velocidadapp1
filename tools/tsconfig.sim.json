{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": "..",
    "paths": { "@/*": ["src/*"] },
    "rootDir": "../src",
    "outDir": "../.sim-build"
  },
  "include": [
    "../src/services/tripEngine.ts",
    "../src/utils/geo.ts",
    "../src/utils/format.ts",
    "../src/vehicles/polo.ts"
  ]
}
